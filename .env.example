# Database Configuration
MONGODB_URI=mongodb://localhost:27017/custom-ngrok
JWT_SECRET=your-jwt-secret-here

# Server Configuration
PORT=5050
TUNNEL_START_PORT=8000
TUNNEL_END_PORT=8100

# Email Configuration
# Choose email provider: 'nodemailer' or 'sendgrid'
EMAIL_PROVIDER=nodemailer

# For nodemailer (Gmail, Outlook, etc.)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# For SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Optional: Reply-to address
EMAIL_REPLY_TO=support@yourdomain.com

# Note: If using SendGrid, set EMAIL_PROVIDER=sendgrid
# and provide SENDGRID_API_KEY and SENDGRID_FROM_EMAIL
